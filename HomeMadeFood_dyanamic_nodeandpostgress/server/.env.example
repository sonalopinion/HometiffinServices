PORT=5000
# Either a single URL...
DATABASE_URL=postgres://postgres:postgres@localhost:5432/homemade_food
# ...set DATABASE_SSL=true for hosted DBs (Neon, Supabase, Render, etc.)
DATABASE_SSL=false
# Long random string: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
# Your Next.js site origin(s), comma separated
CORS_ORIGIN=http://localhost:3000
